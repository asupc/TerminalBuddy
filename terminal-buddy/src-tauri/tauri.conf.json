{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerminalBuddy",
  "identifier": "com.terminalbuddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1450",
    "beforeBuildCommand": "npm run prepare:vscode-terminal && npm run build && cd web && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TerminalBuddy",
        "width": 1200,
        "height": 800,
        "center": true,
        "maximized": false,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#1e1e1e",
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
