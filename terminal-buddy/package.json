{
  "name": "terminal-buddy",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode browser",
    "dev:web:demo": "vite --mode browser-demo",
    "build:web:desktop": "tsc && vite build --mode browser",
    "server:dev": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features server --bin terminal-buddy-server",
    "build": "tsc && vite build",
    "prepare:vscode-terminal": "node scripts/prepare-vscode-terminal-plugin.mjs",
    "test:vscode-terminal": "node scripts/test-vscode-terminal-plugin.mjs",
    "test:vscode-terminal:bundled": "npm run prepare:vscode-terminal && node scripts/test-vscode-terminal-plugin.mjs --bundled",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@xterm/addon-clipboard": "^0.3.0-beta.335",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.17.0-beta.331",
    "@xterm/addon-unicode11": "^0.10.0-beta.331",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.20.0-beta.330",
    "@xterm/xterm": "^6.1.0-beta.337",
    "@xyflow/react": "^12.12.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.72.0",
    "markdown-it": "^14.3.3",
    "monaco-editor": "^0.57.0",
    "node-pty": "1.2.0-beta.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.13": true
  }
}
