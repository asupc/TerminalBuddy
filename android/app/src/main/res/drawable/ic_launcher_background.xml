<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="768"
    android:viewportHeight="768">
    <!-- 背景铺满图标，渐变范围与居中的原始 Logo 一致。 -->
    <path android:pathData="M0,0 H768 V768 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="128"
                android:startY="128"
                android:endX="640"
                android:endY="640">
                <item android:offset="0" android:color="@color/launcher_background" />
                <item android:offset="1" android:color="#0D121B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
