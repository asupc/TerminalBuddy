# 统一换行符策略：避免 Windows 检出（core.autocrlf=true）把 Linux 脚本变成 CRLF，
# 导致容器内 / 服务器上 `bash script.sh` 报 "$'\r': command not found"。

* text=auto

# Linux/Unix 脚本必须保持 LF
*.sh   text eol=lf
*.py   text eol=lf
Dockerfile* text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Windows 脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz  binary
*.tar binary
*.exe binary
*.dll binary