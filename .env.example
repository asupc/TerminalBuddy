TERMINAL_BUDDY_USERNAME=admin
TERMINAL_BUDDY_PORT=9600
# 经同机 HTTPS 反向代理访问时保留 127.0.0.1；局域网直连可改为 0.0.0.0。
TERMINAL_BUDDY_BIND_ADDRESS=127.0.0.1
# 填写宿主机上已存在的项目根目录（Windows 上可用 D:/projects 这种正斜杠路径）。
TERMINAL_BUDDY_WORKSPACE=/srv/projects
# Linux 建议与宿主机工作区使用相同绝对路径，确保 Compose 的相对目录挂载正确。
# Windows Docker Desktop 保持 /workspace，部署应用的 bind source 需使用宿主机可访问的路径。
TERMINAL_BUDDY_CONTAINER_WORKSPACE=/srv/projects
# 可选：补充容器内可浏览目录；Linux 用冒号分隔，Windows 独立服务端用分号分隔。
# Docker 挂载目录会自动识别，通常无需配置；此设置不会创建 Docker 挂载。
# TERMINAL_BUDDY_BROWSE_ROOTS=/srv/projects:/srv/code
# Linux：stat -c '%g' /var/run/docker.sock；Docker Desktop 通常为 0。
TERMINAL_BUDDY_DOCKER_GID=0
TERMINAL_BUDDY_DOCKER_SOCKET=/var/run/docker.sock
# 首次启动：打开网页后创建管理员密码（至少 8 个字符），无需预先准备密码文件。
